{
  "name": "a-forca-medieval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "test": "node --test",
    "wrangler:dev": "wrangler dev --config worker/wrangler.jsonc",
    "wrangler:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc --env \"\"",
    "db:migrate:local": "wrangler d1 migrations apply a-forca-medieval-local --local --config worker/wrangler.jsonc",
    "words:import": "node scripts/import-word-bank.mjs",
    "check": "npm test && npm run build && npm run db:migrate:local && npm run wrangler:check"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
