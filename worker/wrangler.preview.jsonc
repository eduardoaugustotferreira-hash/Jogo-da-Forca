{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "a-forca-medieval-api-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "preview"
  },
  // Add this environment's approved D1 database ID before enabling remote deploys.
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
